PORT=5000
DATABASE_URL=postgres://majisafe:majisafe@localhost:5432/majisafe
JWT_SECRET=change-this-to-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# TLS: 'true' forces TLS, 'false' disables it, unset lets sslmode/host decide.
PGSSL=
# How long a query waits for a (possibly sleeping) database to accept a connection.
PG_CONNECT_TIMEOUT_MS=20000
INGEST_SECRET=
# First admin (created automatically on boot if no admin exists):
ADMIN_EMAIL=admin@majisafe.ke
ADMIN_PASSWORD=change-me-immediately
